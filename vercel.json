{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 10 */2 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/arknights/(.*)",
      "destination": "/api/arknights"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
